import os
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import ApplicationBuilder, CommandHandler, CallbackQueryHandler, ContextTypes

TOKEN = os.getenv("BOT_TOKEN")

# الاسم المزخرف
BRAND = "𓆩✦ 𝐀𝐋-𝐐𝐈𝐘𝐀𝐃𝐀 • شَــوقِــي ✦𓆪"
USERNAME = "@JerryKim78"

SERVICES = {
    "store": {
        "name": "🛒 متجر القيادة",
        "desc": "متجر القيادة شوقي\n\nكل المنتجات والخدمات المتوفرة\nالاسعار - طريقة الطلب - التوصيل\n\nللطلب تواصل معنا: " + USERNAME
    },
    "design": {
        "name": "🎨 تصميم",
        "desc": "خدمة التصميم\n\n- تصميم شعارات\n- تصميم منشورات\n- تصميم هويات بصرية\n\nللطلب: " + USERNAME
    },
    "coding": {
        "name": "💻 برمجة",
        "desc": "خدمة البرمجة\n\n- برمجة بوتات تليجرام\n- برمجة مواقع\n- برمجة تطبيقات\n\nللطلب: " + USERNAME
    },
    "marketing": {
        "name": "📣 تسويق",
        "desc": "خدمة التسويق\n\n- ادارة حسابات\n- زيادة متابعين\n- اعلانات ممولة\n\nللطلب: " + USERNAME
    },
    "support": {
        "name": "📞 تواصل معنا",
        "desc": "تواصل مع القيادة شوقي شخصيا\n\nتليجرام: " + USERNAME + "\n\nنرد عليك باسرع وقت"
    },
}

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    keyboard = [[InlineKeyboardButton(v["name"], callback_data=k)] for k, v in SERVICES.items()]
    text = (
        f"{BRAND}\n"
        "━━━━━━━━━━━━━━━\n"
        "اهلا فيك في بوت القيادة شوقي شخصيا 👑\n\n"
        "اختر الخدمة اللي تبيها من القائمة تحت:\n"
        "━━━━━━━━━━━━━━━"
    )
    if update.message:
        await update.message.reply_text(text, reply_markup=InlineKeyboardMarkup(keyboard))
    else:
        await update.callback_query.edit_message_text(text, reply_markup=InlineKeyboardMarkup(keyboard))

async def button(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    if query.data == "back":
        await start(update, context)
        return
    service = SERVICES.get(query.data)
    if service:
        keyboard = [[InlineKeyboardButton("🔙 رجوع للقائمة", callback_data="back")]]
        await query.edit_message_text(
            f"{BRAND}\n━━━━━━━━━━━━━━━\n\n{service['name']}\n\n{service['desc']}",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )

if __name__ == "__main__":
    app = ApplicationBuilder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(button))
    print("Bot القيادة شوقي is running...")
    app.run_polling()
